{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svg-animator.invalid/schemas/runtime-bundle-v1.schema.json",
  "title": "SVG Animator RuntimeBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "formatVersion", "generator", "requiredCapabilities", "artwork", "animation"],
  "properties": {
    "kind": { "const": "svg-animator/runtime-bundle" },
    "formatVersion": { "const": 1 },
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "const": "SVG Animator" }, "version": { "type": "string" } }
    },
    "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
    "rigs": { "$ref": "#/$defs/rigDocument" },
    "artwork": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "signature", "width", "height", "viewBox", "targets"],
      "properties": {
        "id": { "type": "string" }, "signature": { "type": "string", "pattern": "^fnv1a32-[0-9a-f]{8}$" },
        "width": { "type": "number" }, "height": { "type": "number" },
        "viewBox": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}], "items": false },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } }
      }
    },
    "animation": {
      "type": "object", "additionalProperties": false,
      "required": ["duration", "loop", "markers", "variables", "targets", "properties", "tracks"],
      "properties": {
        "duration": { "type": "number", "minimum": 0 }, "loop": { "type": "boolean" },
        "markers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "time", "name"], "properties": { "id": {"type":"string"}, "time": {"type":"number"}, "name": {"type":"string"} } } },
        "variables": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": { "name": {"type":"string"}, "value": { "type": ["number", "string", "boolean"] } } } },
        "targets": { "type": "array", "items": {"type":"string"} }, "properties": { "type": "array", "items": {"type":"string"} },
        "tracks": { "type": "array", "items": { "oneOf": [{"$ref":"#/$defs/numericTrack"},{"$ref":"#/$defs/colorTrack"},{"$ref":"#/$defs/discreteTrack"}] } }
      }
    }
  },
  "$defs": {
    "capability": { "enum": ["tracks.numeric-v1","tracks.color-v1","tracks.discrete-v1","composition.action-windows-v1","composition.action-timing-v1","rig.pose-v1","render.transforms-v1","render.geometry-v1","render.paint-v1","render.gradient-v1","render.path-v1","render.outline-sections-v1","render.clipping-v1","render.visible-clipping-v1","render.motion-path-v1"] },
    "rigDocument": { "type":"object", "additionalProperties":false, "required":["version","armatures"], "properties":{"version":{"enum":[1,2,3,4,5]},"armatures":{"type":"array","items":{"$ref":"#/$defs/armature"}}} },
    "matrix": { "type":"object", "additionalProperties":false, "required":["a","b","c","d","e","f"], "properties":{"a":{"type":"number"},"b":{"type":"number"},"c":{"type":"number"},"d":{"type":"number"},"e":{"type":"number"},"f":{"type":"number"}} },
    "rigTransform": { "type":"object", "additionalProperties":false, "required":["translateX","translateY","scaleX","scaleY","rotation"], "properties":{"translateX":{"type":"number"},"translateY":{"type":"number"},"scaleX":{"type":"number"},"scaleY":{"type":"number"},"rotation":{"type":"number"},"originX":{"type":"number"},"originY":{"type":"number"}} },
    "bone": { "type":"object", "additionalProperties":false, "required":["id","name","parentId","x","y","angle","length","pose"], "properties":{"id":{"type":"string"},"name":{"type":"string"},"kind":{"enum":["bone","point"]},"parentId":{"type":["string","null"]},"x":{"type":"number"},"y":{"type":"number"},"angle":{"type":"number"},"length":{"type":"number","minimum":0},"pose":{"type":"number"},"poseX":{"type":"number"},"poseY":{"type":"number"}} },
    "boundPoint": { "type":"object", "additionalProperties":false, "required":["id","anchorId","x","y","weights"], "properties":{"id":{"type":"string"},"anchorId":{"type":"string"},"x":{"type":"number"},"y":{"type":"number"},"independent":{"type":"boolean"},"lockedBoneIds":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"weightSource":{"type":"object","additionalProperties":false,"required":["pathId","pointId"],"properties":{"pathId":{"type":"string"},"pointId":{"type":"string"}}},"weights":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["boneId","weight"],"properties":{"boneId":{"type":"string"},"weight":{"type":"number","exclusiveMinimum":0,"maximum":1}}}}} },
    "pathBinding": { "type":"object", "additionalProperties":false, "required":["pathId","matrix","topology","points"], "properties":{"pathId":{"type":"string"},"scopeId":{"type":"string"},"matrix":{"$ref":"#/$defs/matrix"},"topology":{"type":"string"},"boneIds":{"type":"array","uniqueItems":true,"minItems":1,"items":{"type":"string"}},"points":{"type":"array","items":{"$ref":"#/$defs/boundPoint"}}} },
    "rigidAttachment": { "type":"object", "additionalProperties":false, "required":["elementId","boneId","parentMatrix","worldMatrix","restTransform"], "properties":{"elementId":{"type":"string"},"boneId":{"type":"string"},"parentMatrix":{"$ref":"#/$defs/matrix"},"worldMatrix":{"$ref":"#/$defs/matrix"},"restTransform":{"$ref":"#/$defs/rigTransform"}} },
    "ikConstraint": { "type":"object", "additionalProperties":false, "required":["id","name","type","enabled","upperBoneId","lowerBoneId","targetBoneId","bend"], "properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"const":"two-bone-ik"},"enabled":{"type":"boolean"},"upperBoneId":{"type":"string"},"lowerBoneId":{"type":"string"},"targetBoneId":{"type":"string"},"bend":{"enum":[1,-1]}} },
    "armature": { "type":"object", "additionalProperties":false, "required":["id","name","bones","bindings"], "properties":{"id":{"type":"string"},"name":{"type":"string"},"bones":{"type":"array","items":{"$ref":"#/$defs/bone"}},"bindings":{"type":"array","items":{"$ref":"#/$defs/pathBinding"}},"attachments":{"type":"array","items":{"$ref":"#/$defs/rigidAttachment"}},"constraints":{"type":"array","items":{"$ref":"#/$defs/ikConstraint"}},"constraintsActive":{"type":"boolean"}} },
    "point": { "type":"object", "additionalProperties":false, "required":["id","x","y"], "properties":{"id":{"type":"string"},"x":{"type":"number"},"y":{"type":"number"},"cornerRadius":{"type":"number","minimum":0}} },
    "line": { "type":"object", "additionalProperties":false, "required":["id","type","points"], "properties":{"id":{"type":"string"},"type":{"enum":["line","bezier"]},"points":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/point"}},"controlStart":{"$ref":"#/$defs/point"},"controlEnd":{"$ref":"#/$defs/point"}} },
    "paint": { "oneOf": [
      {"type":"null"},
      {"type":"object","additionalProperties":false,"required":["kind","color","opacity"],"properties":{"kind":{"const":"solid"},"color":{"type":"string"},"opacity":{"type":"number","minimum":0,"maximum":1}}},
      {"type":"object","required":["kind","id","gradientType","units","spreadMethod","transform","coordinates","stops"],"properties":{"kind":{"const":"gradient"},"id":{"type":"string"},"gradientType":{"enum":["linear-gradient","radial-gradient"]},"units":{"enum":["objectBoundingBox","userSpaceOnUse"]},"spreadMethod":{"enum":["pad","reflect","repeat"]},"transform":{"type":"array","minItems":6,"maxItems":6,"items":{"type":"number"}},"coordinates":{"type":"object","additionalProperties":{"type":"number"}},"stops":{"type":"array","items":{"type":"object","required":["id","offset","color","opacity"],"properties":{"id":{"type":"string"},"offset":{"type":"number"},"color":{"type":"string"},"opacity":{"type":"number"}}}}}}
    ]},
    "outlinePosition": { "type":"object", "additionalProperties":false, "required":["segmentId","t"], "properties":{"segmentId":{"type":"string"},"t":{"type":"number","minimum":0,"maximum":1}} },
    "outlineTaper": { "type":"object", "additionalProperties":false, "required":["length","tipWidth"], "properties":{"length":{"type":"number","minimum":0,"maximum":1},"tipWidth":{"type":"number","minimum":0,"maximum":1}} },
    "outlineSection": { "type":"object", "additionalProperties":false, "required":["id","contourId","start","end"], "properties":{"id":{"type":"string"},"contourId":{"type":"string"},"start":{"$ref":"#/$defs/outlinePosition"},"end":{"$ref":"#/$defs/outlinePosition"},"startTaper":{"$ref":"#/$defs/outlineTaper"},"endTaper":{"$ref":"#/$defs/outlineTaper"},"fullContour":{"type":"boolean"}} },
    "target": {
      "type":"object", "required":["id","parentId","type","visible","opacity","transform","motion","geometry","paints"],
      "properties": {
        "id":{"type":"string"},"parentId":{"type":["string","null"]},"type":{"enum":["group","path","rectangle","ellipse","text"]},"visible":{"type":"boolean"},"opacity":{"type":"number"},
        "transform":{"type":"object","additionalProperties":false,"required":["translateX","translateY","scaleX","scaleY","rotation","originX","originY","autoOrigin"],"properties":{"translateX":{"type":"number"},"translateY":{"type":"number"},"scaleX":{"type":"number"},"scaleY":{"type":"number"},"rotation":{"type":"number"},"originX":{"type":"number"},"originY":{"type":"number"},"autoOrigin":{"type":"boolean"}}},
        "motion":{"type":"object","required":["pathId","progress","offsetX","offsetY","rotateToPath","offsetAngle"]},
        "geometry":{"type":"object","required":["x","y","width","height"],"additionalProperties":{"type":"number"}},
        "paints":{"type":"object","properties":{"fill":{"$ref":"#/$defs/paint"},"stroke":{"$ref":"#/$defs/paint"},"color":{"$ref":"#/$defs/paint"}}},
        "path":{"type":"object","required":["contours","fillRule","drawProgress","rounded"],"properties":{"contours":{"type":"array","items":{"type":"object","required":["id","closed","lines"],"properties":{"id":{"type":"string"},"closed":{"type":"boolean"},"lines":{"type":"array","items":{"$ref":"#/$defs/line"}}}}},"fillRule":{"enum":["nonzero","evenodd"]},"drawProgress":{"type":"number"},"rounded":{"type":"boolean"},"explicitClosure":{"type":"boolean"},"outlineSections":{"type":"array","items":{"$ref":"#/$defs/outlineSection"}}}},
        "stroke":{"type":"object","required":["width","alignment","dasharray","dashoffset"],"properties":{"width":{"type":"number"},"alignment":{"enum":["inside","center","outside"]},"dasharray":{"type":"array","items":{"type":"number"}},"dashoffset":{"type":"number"},"lineCap":{"enum":["butt","round","square",null]},"lineJoin":{"enum":["miter","round","bevel",null]},"miterLimit":{"type":"number"}}},
        "clipping":{"type":"object","required":["clipElementId","clipPathId"],"properties":{"clipElementId":{"type":"string"},"clipPathId":{"type":"string"},"sourceVisibility":{"const":true}}}
      }
    },
    "actionWindow": { "type":"object", "additionalProperties":false, "required":["start","end","track"], "properties":{"start":{"type":"number","minimum":0},"end":{"type":"number","exclusiveMinimum":0},"track":{"oneOf":[{"$ref":"#/$defs/numericTrack"},{"$ref":"#/$defs/colorTrack"},{"$ref":"#/$defs/discreteTrack"}]},"timing":{"type":"object","additionalProperties":false,"required":["sourceStart","sourceEnd","rate"],"properties":{"sourceStart":{"type":"number","minimum":0},"sourceEnd":{"type":"number","exclusiveMinimum":0},"rate":{"type":"number","minimum":0.01,"maximum":100}}}} },
    "trackBase": { "type":"object", "required":["kind","target","property","times","values"], "properties":{"target":{"type":"integer","minimum":0},"property":{"type":"integer","minimum":0},"times":{"type":"array","items":{"type":"number"}},"actionWindows":{"type":"array","items":{"$ref":"#/$defs/actionWindow"}}} },
    "numericTrack": { "allOf":[{"$ref":"#/$defs/trackBase"},{"type":"object","properties":{"kind":{"const":"number"},"values":{"type":"array","items":{"type":"number"}},"segmentModes":{"type":"array","items":{"enum":["linear","hold","ease-in","ease-out","ease-in-out","temporal"]}},"temporalCoefficients":{"type":"array","items":{"type":"number"}}},"required":["segmentModes","temporalCoefficients"]}] },
    "colorTrack": { "allOf":[{"$ref":"#/$defs/trackBase"},{"type":"object","properties":{"kind":{"const":"color"},"values":{"type":"array","items":{"type":"integer"}},"segmentModes":{"type":"array"},"interpolationSpaces":{"type":"array","items":{"enum":["rgb","hsl"]}}},"required":["segmentModes","interpolationSpaces"]}] },
    "discreteTrack": { "allOf":[{"$ref":"#/$defs/trackBase"},{"type":"object","properties":{"kind":{"enum":["boolean","string"]},"values":{"type":"array","items":{"type":["boolean","string"]}}}}] }
  }
}
